# Copy to .env for Docker Compose. Do not put secret values in this file.
RESET_HOST_PORT=8799
# The checked-in image owns /data and /bot-data as 1000:1000. Prepare matching
# writable volume ownership yourself before changing these IDs.
RESET_UID=1000
RESET_GID=1000
RESET_DATA_VOLUME=codex-reset-forecaster-data-v1
# Live target: qualifying Tibo completion statements, not every physical reset.
# Use /app/config/default.json only for the provider-neutral baseline profile.
RESET_CONFIG=/app/config/tibo-authority-live.json
RESET_SCHEDULER_ENABLED=true
RESET_RUN_ON_START=true
RESET_PUBLIC_BASE_URL=https://codexreset.dreaife.tokyo
RESET_PUBLICATION_ENABLED=true

# True background browser notifications require one persistent VAPID key pair.
# Generate it into an ignored mode-600 file with:
# npm run web-push:generate-keys -- --output .secrets/web-push-vapid.json \
#   --subject mailto:you@example.com
# Keep Web Push disabled until that file exists and the public subscription route
# has edge rate-limit plus anti-automation protection. Never paste the private key here.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_KEYS_FILE_HOST=/dev/null
WEB_PUSH_VAPID_KEYS_FILE=/run/secrets/web-push-vapid.json
WEB_PUSH_VAPID_SUBJECT=

# LAN X Search Gateway. The bearer token remains in its existing mode-600 host
# file and is mounted read-only; its value is never copied into this repository.
X_SEARCH_GATEWAY_ENABLED=false
X_SEARCH_GATEWAY_URL=http://host.docker.internal:8787
X_SEARCH_GATEWAY_PROVIDER=grokbuild
X_SEARCH_GATEWAY_TOKEN_FILE_HOST=/dev/null
X_SEARCH_GATEWAY_TOKEN_FILE=/run/secrets/x-search-gateway-token

# Optional fail-closed semantic timing assistance. Only public authority wrapper
# and exact quote text are sent. The model may assist scheduled/expected/started
# classification, but can never confirm a completed reset or set probability.
# To enable it, put only the API key in a mode-400/600 host file, set the host
# mount below, and use /run/secrets/semantic-assistance-token in the container.
RESET_SEMANTIC_ASSISTANCE_ENABLED=false
RESET_SEMANTIC_ASSISTANCE_BASE_URL=https://tokenflux.dev/v1
RESET_SEMANTIC_ASSISTANCE_MODEL=deepseek-v4-flash
RESET_SEMANTIC_ASSISTANCE_TOKEN_FILE_HOST=/dev/null
RESET_SEMANTIC_ASSISTANCE_TOKEN_FILE=

# Direct X is optional. To enable it in Compose, put only the token in the
# mode-400/600 host file and set the in-container path below. Never put the token
# value in .env. Leave X_BEARER_TOKEN_FILE empty to keep direct X disabled.
X_BEARER_TOKEN_FILE_HOST=/dev/null
X_BEARER_TOKEN_FILE=

# The default archive profile is outcome-discovery-only. The selected Tibo live
# profile may promote a closed UTC day only after its versioned 36h/two-fetch/6h
# daily-ledger stability gate; a first deployment remains pending.
HISTORICAL_MONITOR_ENABLED=true
HISTORICAL_MONITOR_URL=https://codex-resets.com/

# Optional public Telegram Bot service. Start it with the telegram Compose profile
# only after creating the token file and naming at least one administrator. Any
# private user may query/subscribe; groups are disabled unless listed explicitly.
# Run only one bot replica per volume.
# The token file contains only the BotFather token and must be mode 400 or 600.
TELEGRAM_BOT_TOKEN_FILE_HOST=/dev/null
TELEGRAM_BOT_API_BASE=https://api.telegram.org
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_BLOCKED_USER_IDS=
TELEGRAM_ALLOWED_GROUP_CHAT_IDS=
TELEGRAM_NOTIFICATION_CHAT_IDS=
# Deployment-only chats for the fixed public 4h/50% experimental stream. Ordinary
# private users configure personalized rules with /subscribe probability ... .
TELEGRAM_EXPERIMENTAL_CHAT_IDS=
TELEGRAM_COMMAND_RATE_LIMIT=12
TELEGRAM_COMMAND_RATE_WINDOW_SECONDS=60
# Personalized 1-168h probability watches consume the core's read-only forecast
# input cursor. The first poll and every cursor reset are silent baselines.
TELEGRAM_FORECAST_INPUT_POLL_INTERVAL_MS=30000
# IANA display zone for Bot messages. Asia/Tokyo is a fixed UTC+9 zone; rendered
# timestamps include the resolved UTC offset (for example, "UTC+9").
TELEGRAM_DISPLAY_TIME_ZONE=Asia/Tokyo
TELEGRAM_BOT_DATA_VOLUME=codex-reset-forecaster-bot-data-v1

# Shared operations-plane token for the protected traffic endpoint and the bot's
# admin-only /traffic command. Keep the token in a 400/600 file, never in .env.
TRAFFIC_MONITOR_ENABLED=true
FORECASTER_OPERATIONS_TOKEN_FILE_HOST=/dev/null
# When enabled, set this to /run/secrets/forecaster-operations-token; leaving it
# empty keeps the protected operations API unavailable while collection continues.
FORECASTER_OPERATIONS_TOKEN_FILE=
# Poll capacity alerts into the administrators' private chats. Every configured
# administrator must first send /start to the Bot because a Bot cannot initiate a
# private chat. First poll is a tail baseline and never replays an old alert backlog.
TELEGRAM_OPERATIONS_ALERTS_ENABLED=false
TELEGRAM_OPERATIONS_ALERT_POLL_INTERVAL_MS=60000

# Existing locally-managed Cloudflare Tunnel network.
CLOUDFLARE_TUNNEL_NETWORK=cloudflare_tunnel
