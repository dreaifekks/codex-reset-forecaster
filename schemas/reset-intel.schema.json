{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reset-intel/0.2/reset-intel.schema.json",
  "title": "Reset Intelligence Record",
  "description": "Provider-neutral, append-only records for platform reset timing intelligence.",
  "allOf": [
    { "$ref": "#/$defs/envelope" },
    {
      "oneOf": [
        {
          "properties": {
            "record_type": { "const": "raw_observation" },
            "data": { "$ref": "#/$defs/rawObservation" }
          }
        },
        {
          "properties": {
            "record_type": { "const": "normalized_signal" },
            "data": { "$ref": "#/$defs/normalizedSignal" }
          }
        },
        {
          "properties": {
            "record_type": { "const": "event_candidate" },
            "data": { "$ref": "#/$defs/eventCandidate" }
          }
        },
        {
          "properties": {
            "record_type": { "const": "reset_outcome" },
            "data": { "$ref": "#/$defs/resetOutcome" }
          }
        },
        {
          "properties": {
            "record_type": { "const": "feature_snapshot" },
            "data": { "$ref": "#/$defs/featureSnapshot" }
          }
        },
        {
          "properties": {
            "record_type": { "const": "prediction" },
            "data": { "$ref": "#/$defs/prediction" }
          }
        },
        {
          "properties": {
            "record_type": { "const": "prediction_settlement" },
            "data": { "$ref": "#/$defs/predictionSettlement" }
          }
        }
      ]
    }
  ],
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nullableUtcTimestamp": {
      "oneOf": [
        { "$ref": "#/$defs/utcTimestamp" },
        { "type": "null" }
      ]
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "config_hash": { "type": ["string", "null"] }
      }
    },
    "recordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "revision"],
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "coverageAssertionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "revision"],
      "properties": {
        "assertion_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "boundary"],
      "properties": {
        "start": { "$ref": "#/$defs/utcTimestamp" },
        "end": { "$ref": "#/$defs/utcTimestamp" },
        "boundary": { "const": "[start,end)" },
        "precision": {
          "enum": [
            "exact",
            "minute",
            "hour",
            "part_of_day",
            "day",
            "week",
            "interval_observed",
            "unknown"
          ]
        },
        "timezone_basis": { "type": ["string", "null"] },
        "original_text": { "type": ["string", "null"] }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "product", "population"],
      "properties": {
        "vendor": { "type": "string", "minLength": 1 },
        "product": { "type": "string", "minLength": 1 },
        "products": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "population": {
          "enum": ["platform", "affected_users", "plan", "region", "account", "unknown"]
        },
        "plans": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "regions": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "quota_bucket": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "product": { "const": "multi_product" } },
            "required": ["product"]
          },
          "then": { "required": ["products"] }
        }
      ]
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "record_id",
        "revision",
        "supersedes",
        "created_at",
        "producer",
        "data"
      ],
      "properties": {
        "schema_version": { "const": "reset-intel/0.2" },
        "record_type": {
          "enum": [
            "raw_observation",
            "normalized_signal",
            "event_candidate",
            "reset_outcome",
            "feature_snapshot",
            "prediction",
            "prediction_settlement"
          ]
        },
        "record_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "supersedes": {
          "oneOf": [
            { "$ref": "#/$defs/recordRef" },
            { "type": "null" }
          ]
        },
        "created_at": { "$ref": "#/$defs/utcTimestamp" },
        "producer": { "$ref": "#/$defs/producer" },
        "data": { "type": "object" }
      }
    },
    "rawObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingest_provider",
        "provider_item_id",
        "canonical_url",
        "published_at",
        "first_seen_at",
        "fetched_at",
        "availability_attestation",
        "author",
        "native_relations",
        "content"
      ],
      "properties": {
        "ingest_provider": { "type": "string", "minLength": 1 },
        "provider_item_id": { "type": "string", "minLength": 1 },
        "canonical_url": { "type": ["string", "null"] },
        "published_at": { "$ref": "#/$defs/nullableUtcTimestamp" },
        "first_seen_at": { "$ref": "#/$defs/utcTimestamp" },
        "fetched_at": { "$ref": "#/$defs/utcTimestamp" },
        "availability_attestation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["available_at", "basis", "attestor_url", "verified_at", "verification"],
              "properties": {
                "available_at": { "$ref": "#/$defs/utcTimestamp" },
                "basis": {
                  "enum": ["direct_source_publication", "archive_snapshot", "provider_first_seen"]
                },
                "attestor_url": { "type": "string", "minLength": 1 },
                "verified_at": { "$ref": "#/$defs/utcTimestamp" },
                "verification": { "type": "string", "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider_author_id", "identity_id", "display_handle"],
          "properties": {
            "provider_author_id": { "type": ["string", "null"] },
            "identity_id": { "type": ["string", "null"] },
            "display_handle": { "type": ["string", "null"] }
          }
        },
        "native_relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "provider_item_id"],
            "properties": {
              "type": { "enum": ["quotes", "repost", "reply", "links", "unknown"] },
              "provider_item_id": { "type": ["string", "null"] },
              "url": { "type": ["string", "null"] }
            }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["media_type", "text", "language", "content_hash", "raw_payload_ref"],
          "properties": {
            "media_type": { "type": "string" },
            "text": { "type": "string" },
            "language": { "type": ["string", "null"] },
            "content_hash": { "type": "string", "minLength": 1 },
            "raw_payload_ref": { "type": ["string", "null"] },
            "raw_payload_hash": { "type": ["string", "null"] }
          }
        },
        "material_hash": { "type": ["string", "null"] },
        "selection_context": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "feature_eligible": { "type": "boolean" },
                "outcome_conditioned": { "type": "boolean" },
                "selection_method": { "type": "string" },
                "linked_from": {
                  "type": "array",
                  "items": { "type": "string" },
                  "uniqueItems": true
                }
              }
            },
            { "type": "null" }
          ]
        },
        "source_timing": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_published_at", "provider_observed_at", "availability_basis"],
              "properties": {
                "source_published_at": { "$ref": "#/$defs/nullableUtcTimestamp" },
                "provider_observed_at": { "$ref": "#/$defs/nullableUtcTimestamp" },
                "availability_basis": { "type": "string", "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "normalizedSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_refs",
        "available_at",
        "taxonomy_version",
        "claim",
        "provenance",
        "extraction"
      ],
      "properties": {
        "observation_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/recordRef" }
        },
        "available_at": { "$ref": "#/$defs/utcTimestamp" },
        "taxonomy_version": { "type": "string", "minLength": 1 },
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_type", "phase", "stance", "scope", "asserted_time_range", "author_certainty"],
          "properties": {
            "event_type": {
              "enum": [
                "quota_reset",
                "quota_refill",
                "limit_policy_change",
                "capacity_restore",
                "incident",
                "release",
                "development_activity",
                "competitor_limit_change",
                "experience_issue",
                "experience_recovery",
                "competitor_model_release"
              ]
            },
            "phase": {
              "enum": ["rumor", "expected", "scheduled", "started", "completed", "denied", "cancelled"]
            },
            "stance": { "enum": ["supports", "contradicts", "neutral", "unknown"] },
            "scope": { "$ref": "#/$defs/scope" },
            "asserted_time_range": {
              "oneOf": [
                { "$ref": "#/$defs/timeRange" },
                { "type": "null" }
              ]
            },
            "author_certainty": { "enum": ["explicit", "probable", "possible", "unknown"] },
            "impact": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "category",
                    "severity",
                    "lifecycle",
                    "affected_scope",
                    "affected_surfaces",
                    "workaround",
                    "evidence_basis"
                  ],
                  "properties": {
                    "category": {
                      "enum": [
                        "availability",
                        "performance",
                        "correctness",
                        "tool_execution",
                        "session_state",
                        "quota_accounting",
                        "auth",
                        "client_ux",
                        "other"
                      ]
                    },
                    "severity": {
                      "enum": ["critical", "high", "medium", "low", "unknown"]
                    },
                    "lifecycle": {
                      "enum": ["active", "investigating", "mitigating", "resolved", "unknown"]
                    },
                    "affected_scope": {
                      "enum": ["individual", "multiple_users", "platform", "unknown"]
                    },
                    "affected_surfaces": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "cli",
                          "ide",
                          "api",
                          "web",
                          "agent_loop",
                          "tool_use",
                          "mcp",
                          "auth",
                          "fast_mode",
                          "unknown"
                        ]
                      }
                    },
                    "workaround": {
                      "enum": ["none", "partial", "available", "unknown"]
                    },
                    "evidence_basis": {
                      "enum": [
                        "first_party_report",
                        "independent_corroboration",
                        "official_incident",
                        "reproduction",
                        "unknown"
                      ]
                    }
                  }
                },
                { "type": "null" }
              ]
            },
            "competitive_context": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "relevance", "stage"],
                  "properties": {
                    "kind": {
                      "enum": [
                        "model_release",
                        "coding_agent_release",
                        "capability_release",
                        "limit_change",
                        "pricing_change"
                      ]
                    },
                    "relevance": {
                      "enum": ["direct", "adjacent", "weak", "unknown"]
                    },
                    "stage": {
                      "enum": [
                        "announced",
                        "preview",
                        "general_availability",
                        "rolled_out",
                        "rumor"
                      ]
                    }
                  }
                },
                { "type": "null" }
              ]
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_identity_id",
            "source_role",
            "root_evidence_id",
            "derivation",
            "independence_group_id"
          ],
          "properties": {
            "source_identity_id": { "type": ["string", "null"] },
            "source_role": {
              "enum": ["official", "product_lead", "product_team_member", "employee", "community", "aggregator", "unknown"]
            },
            "root_evidence_id": { "type": "string", "minLength": 1 },
            "derivation": { "enum": ["primary_statement", "independent_observation", "quotes", "repost", "reply", "summarizes", "unknown"] },
            "independence_group_id": { "type": "string", "minLength": 1 },
            "feature_eligible": { "type": "boolean" },
            "selection_bias": { "type": ["string", "null"] },
            "source_published_at": { "$ref": "#/$defs/nullableUtcTimestamp" },
            "first_seen_at": { "$ref": "#/$defs/utcTimestamp" },
            "recency_basis": {
              "enum": [
                "source_publication",
                "attested_source_publication",
                "collector_first_seen",
                "asserted_time_range",
                "unknown"
              ]
            },
            "canonical_source_url": { "type": ["string", "null"] }
          }
        },
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "model_version", "prompt_version", "semantic_policy_hash", "confidence"],
          "properties": {
            "model": { "type": "string" },
            "model_version": { "type": "string" },
            "prompt_version": { "type": "string" },
            "semantic_policy_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "confidence": { "$ref": "#/$defs/probability" },
            "relevance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "policy_version",
                "decision",
                "reason_code",
                "basis",
                "matched_segments",
                "context_refs"
              ],
              "properties": {
                "policy_version": { "type": "string", "minLength": 1 },
                "decision": {
                  "enum": ["relevant", "irrelevant", "pending_context"]
                },
                "reason_code": { "type": "string", "minLength": 1 },
                "basis": {
                  "enum": [
                    "self",
                    "reply_parent",
                    "quote",
                    "unresolved_context"
                  ]
                },
                "matched_segments": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "context_refs": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/recordRef" },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    },
    "eventCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "state", "event_type", "scope", "hypothesized_time_range", "event_cluster_id", "evidence"],
      "properties": {
        "as_of": { "$ref": "#/$defs/utcTimestamp" },
        "state": { "enum": ["open", "supported", "contradicted", "closed"] },
        "event_type": { "enum": ["quota_reset", "quota_refill", "capacity_restore"] },
        "scope": { "$ref": "#/$defs/scope" },
        "hypothesized_time_range": {
          "oneOf": [
            { "$ref": "#/$defs/timeRange" },
            { "type": "null" }
          ]
        },
        "event_cluster_id": { "type": "string", "minLength": 1 },
        "identity_basis": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signal_ref", "relation", "provenance_relation", "independence_group_id", "link_confidence"],
            "properties": {
              "signal_ref": { "$ref": "#/$defs/recordRef" },
              "relation": { "enum": ["supports", "contradicts", "context"] },
              "provenance_relation": { "enum": ["independent", "quotes", "repost", "reply", "summarizes", "unknown"] },
              "independence_group_id": { "type": "string" },
              "link_confidence": { "$ref": "#/$defs/probability" }
            }
          }
        }
      }
    },
    "resetOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "event_type", "scope", "occurred_time_range", "known_at", "label_grade", "verification", "candidate_refs"],
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "confirmed" } },
            "required": ["status"]
          },
          "then": {
            "required": ["label_policy_version", "event_identity"],
            "properties": {
              "label_policy_version": { "const": "completed-direct/0.3.1" },
              "event_identity": { "type": "string", "minLength": 1 },
              "occurred_time_range": { "$ref": "#/$defs/timeRange" },
              "candidate_refs": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/recordRef" }
              },
              "verification": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "observation_ref", "independence_group_id"],
                  "properties": {
                    "kind": { "const": "official_confirmation" },
                    "observation_ref": { "$ref": "#/$defs/recordRef" },
                    "independence_group_id": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "status": { "enum": ["confirmed", "rejected", "cancelled"] },
        "label_policy_version": { "type": ["string", "null"] },
        "event_identity": { "type": "string", "minLength": 1 },
        "event_type": { "enum": ["quota_reset", "quota_refill", "capacity_restore"] },
        "scope": { "$ref": "#/$defs/scope" },
        "occurred_time_range": {
          "oneOf": [
            { "$ref": "#/$defs/timeRange" },
            { "type": "null" }
          ]
        },
        "known_at": { "$ref": "#/$defs/utcTimestamp" },
        "replay_available_at": {
          "oneOf": [
            { "$ref": "#/$defs/utcTimestamp" },
            { "type": "null" }
          ]
        },
        "label_grade": { "enum": ["gold", "silver"] },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "observation_ref", "independence_group_id"],
            "properties": {
              "kind": { "enum": ["direct_platform_observation", "official_confirmation", "independent_user_confirmation"] },
              "observation_ref": { "$ref": "#/$defs/recordRef" },
              "independence_group_id": { "type": "string" }
            }
          }
        },
        "candidate_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/recordRef" }
        }
      }
    },
    "featureSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge_cutoff", "config_hash", "feature_schema_version", "taxonomy_version", "deduplication_version", "timezone_database_version", "extractor_model", "extractor_model_version", "extractor_prompt_version", "extractor_semantic_policy_hash", "target", "features", "data_quality", "source_record_refs", "coverage_assertion_refs"],
      "properties": {
        "knowledge_cutoff": { "$ref": "#/$defs/utcTimestamp" },
        "config_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "feature_schema_version": { "type": "string" },
        "taxonomy_version": { "type": "string" },
        "deduplication_version": { "type": "string" },
        "timezone_database_version": { "type": "string" },
        "extractor_model": { "type": "string", "minLength": 1 },
        "extractor_model_version": { "type": "string", "minLength": 1 },
        "extractor_prompt_version": { "type": "string", "minLength": 1 },
        "extractor_semantic_policy_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end", "base_slot", "display_horizon"],
          "properties": {
            "start": { "$ref": "#/$defs/utcTimestamp" },
            "end": { "$ref": "#/$defs/utcTimestamp" },
            "base_slot": { "const": "PT1H" },
            "display_horizon": { "const": "PT4H" }
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": { "type": ["number", "integer", "boolean", "null"] }
        },
        "data_quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider_coverage", "max_delay_seconds", "outcome_sample_count", "sample_sufficiency", "out_of_distribution"],
          "properties": {
            "provider_coverage": { "$ref": "#/$defs/probability" },
            "max_delay_seconds": { "type": "integer", "minimum": 0 },
            "outcome_sample_count": { "type": "integer", "minimum": 0 },
            "sample_sufficiency": { "$ref": "#/$defs/probability" },
            "out_of_distribution": { "type": "boolean" }
          }
        },
        "source_record_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/recordRef" }
        },
        "coverage_assertion_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/coverageAssertionRef" }
        }
      }
    },
    "predictionSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "hazard", "first_reset_probability", "reset_by_end_probability", "rolling_4h_probability"],
      "properties": {
        "start": { "$ref": "#/$defs/utcTimestamp" },
        "end": { "$ref": "#/$defs/utcTimestamp" },
        "hazard": { "$ref": "#/$defs/probability" },
        "first_reset_probability": { "$ref": "#/$defs/probability" },
        "reset_by_end_probability": { "$ref": "#/$defs/probability" },
        "rolling_4h_probability": {
          "oneOf": [
            { "$ref": "#/$defs/probability" },
            { "type": "null" }
          ]
        },
        "epistemic_interval_80": {
          "oneOf": [
            {
              "type": "array",
              "prefixItems": [
                { "$ref": "#/$defs/probability" },
                { "$ref": "#/$defs/probability" }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            { "type": "null" }
          ]
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issued_at",
        "knowledge_cutoff",
        "event_process",
        "scope",
        "horizon",
        "base_slot",
        "display_horizon",
        "slots",
        "no_reset_probability",
        "data_quality",
        "feature_snapshot_refs",
        "model"
      ],
      "properties": {
        "issued_at": { "$ref": "#/$defs/utcTimestamp" },
        "knowledge_cutoff": { "$ref": "#/$defs/utcTimestamp" },
        "event_process": { "enum": ["first_reset", "recurrent"] },
        "scope": { "$ref": "#/$defs/scope" },
        "horizon": { "$ref": "#/$defs/timeRange" },
        "base_slot": { "const": "PT1H" },
        "display_horizon": { "const": "PT4H" },
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 168,
          "items": { "$ref": "#/$defs/predictionSlot" }
        },
        "no_reset_probability": {
          "oneOf": [
            { "$ref": "#/$defs/probability" },
            { "type": "null" }
          ]
        },
        "authority_conditioning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_version",
            "applied",
            "reliability_basis",
            "phase",
            "prior_reliability",
            "signal_ref",
            "asserted_time_range",
            "base_horizon_probability",
            "conditioned_horizon_probability"
          ],
          "properties": {
            "policy_version": {
              "const": "authority-timing-first-event-mixture/1"
            },
            "applied": { "type": "boolean" },
            "reliability_basis": {
              "const": "versioned_prior_non_exhaustive_statement_history"
            },
            "phase": {
              "enum": ["scheduled", "expected", "started", null]
            },
            "prior_reliability": {
              "oneOf": [
                { "$ref": "#/$defs/probability" },
                { "type": "null" }
              ]
            },
            "signal_ref": {
              "oneOf": [
                { "$ref": "#/$defs/recordRef" },
                { "type": "null" }
              ]
            },
            "asserted_time_range": {
              "oneOf": [
                { "$ref": "#/$defs/timeRange" },
                { "type": "null" }
              ]
            },
            "base_horizon_probability": {
              "$ref": "#/$defs/probability"
            },
            "conditioned_horizon_probability": {
              "$ref": "#/$defs/probability"
            }
          }
        },
        "recurrence_anchor": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["outcome_ref", "occurred_time_range"],
              "properties": {
                "outcome_ref": { "$ref": "#/$defs/recordRef" },
                "occurred_time_range": { "$ref": "#/$defs/timeRange" }
              }
            },
            { "type": "null" }
          ]
        },
        "data_quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "provider_coverage", "outcome_sample_count", "sample_sufficiency", "independent_evidence_groups"],
          "properties": {
            "score": { "$ref": "#/$defs/probability" },
            "provider_coverage": { "$ref": "#/$defs/probability" },
            "outcome_sample_count": { "type": "integer", "minimum": 0 },
            "sample_sufficiency": { "$ref": "#/$defs/probability" },
            "independent_evidence_groups": { "type": "integer", "minimum": 0 }
          }
        },
        "feature_snapshot_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 168,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/recordRef" }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "version", "artifact_hash", "model_contract_hash", "training_cutoff", "calibrator_version", "training_data_hash"],
          "properties": {
            "family": { "type": "string" },
            "version": { "type": "string" },
            "artifact_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "model_contract_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "validation_status": { "enum": ["provisional", "validated"] },
            "training_cutoff": { "$ref": "#/$defs/utcTimestamp" },
            "calibrator_version": { "type": ["string", "null"] },
            "training_data_hash": { "type": "string" }
          }
        }
      }
    },
    "predictionSettlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prediction_ref",
        "slot_index",
        "window",
        "display_horizon",
        "status",
        "settled_at",
        "outcome_as_of_mode",
        "coverage_as_of_mode",
        "outcome_refs",
        "coverage_assertion_refs",
        "coverage_assertion_snapshot_hash",
        "coverage",
        "reason"
      ],
      "properties": {
        "prediction_ref": { "$ref": "#/$defs/recordRef" },
        "slot_index": { "type": "integer", "minimum": 0, "maximum": 167 },
        "window": { "$ref": "#/$defs/timeRange" },
        "display_horizon": { "const": "PT4H" },
        "status": { "enum": ["positive", "negative", "pending", "censored"] },
        "settled_at": { "$ref": "#/$defs/utcTimestamp" },
        "outcome_as_of_mode": { "const": "live" },
        "coverage_as_of_mode": { "const": "live" },
        "outcome_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/recordRef" }
        },
        "coverage_assertion_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/coverageAssertionRef" }
        },
        "coverage_assertion_snapshot_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "providers"],
          "properties": {
            "complete": { "type": "boolean" },
            "providers": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
