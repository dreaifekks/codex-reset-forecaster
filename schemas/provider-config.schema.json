{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reset-intel/0.2/provider-config.schema.json",
  "title": "Reset Intelligence Provider Configuration",
  "type": "object",
  "required": ["config_version", "target", "providers"],
  "properties": {
    "config_version": { "type": "string", "minLength": 1 },
    "target": { "$ref": "#/$defs/scope" },
    "providers": {
      "type": "object",
      "required": ["x"],
      "properties": {
        "x": {
          "type": "object",
          "required": ["outcome_exhaustiveness_contract"],
          "properties": {
            "outcome_exhaustiveness_contract": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/xOutcomeExhaustivenessContract" }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "required": ["vendor", "product", "population"],
      "properties": {
        "vendor": { "type": "string", "minLength": 1 },
        "product": { "type": "string", "minLength": 1 },
        "population": { "type": "string", "minLength": 1 },
        "plans": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "regions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "quota_bucket": { "type": ["string", "null"] }
      }
    },
    "xOutcomeExhaustivenessContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "attestation_file", "attestation_sha256"],
      "properties": {
        "version": { "const": "x-outcome-exhaustiveness/1" },
        "attestation_file": { "type": "string", "minLength": 1 },
        "attestation_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "xOutcomeExhaustivenessAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_version",
        "contract_version",
        "provider",
        "exhaustive_for",
        "independent",
        "attestor",
        "method",
        "issued_at",
        "expires_at",
        "target_scope",
        "confirmation_identity_ids",
        "interval"
      ],
      "properties": {
        "attestation_version": {
          "const": "x-outcome-exhaustiveness-attestation/1"
        },
        "contract_version": { "const": "x-outcome-exhaustiveness/1" },
        "provider": { "const": "x" },
        "exhaustive_for": { "const": "completed_platform_reset_outcomes" },
        "independent": { "const": true },
        "attestor": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "issued_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "expires_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "target_scope": { "$ref": "#/$defs/scope" },
        "confirmation_identity_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "interval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end", "boundary"],
          "properties": {
            "start": { "type": "string", "format": "date-time", "pattern": "Z$" },
            "end": { "type": "string", "format": "date-time", "pattern": "Z$" },
            "boundary": { "const": "[start,end)" }
          }
        }
      }
    }
  }
}
