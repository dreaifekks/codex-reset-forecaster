{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reset-intel/0.2/provider-config.schema.json",
  "title": "Reset Intelligence Provider Configuration",
  "type": "object",
  "required": [
    "config_version",
    "extractor",
    "outcome_definition",
    "target",
    "providers",
    "impact_tracking"
  ],
  "properties": {
    "config_version": { "type": "string", "minLength": 1 },
    "extractor": { "$ref": "#/$defs/extractorPolicy" },
    "outcome_definition": { "$ref": "#/$defs/outcomeDefinition" },
    "target": { "$ref": "#/$defs/scope" },
    "providers": {
      "type": "object",
      "required": ["x"],
      "properties": {
        "x": {
          "type": "object",
          "required": ["outcome_exhaustiveness_contract"],
          "properties": {
            "outcome_exhaustiveness_contract": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/xOutcomeExhaustivenessContract" }
              ]
            }
          }
        },
        "x_search_gateway": {
          "$ref": "#/$defs/xSearchGatewayProvider"
        },
        "historical_monitor": {
          "type": "object",
          "properties": {
            "coverage_adequacy": {
              "enum": ["outcome_only", "negative_label_eligible"]
            },
            "coverage_completeness_attestation": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/historicalDailyLedgerAttestation" }
              ]
            }
          }
        },
        "rsshub_x_timeline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "provider_name",
            "capabilities",
            "freshness_max_age_hours",
            "base_url",
            "include_replies",
            "count",
            "minimum_items",
            "max_response_bytes",
            "request_timeout_ms",
            "refresh_interval_minutes",
            "confirmation_identities",
            "context_identities"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "provider_name": { "const": "rsshub_x_timeline" },
            "base_url": {
              "type": "string",
              "pattern": "^https://"
            },
            "include_replies": { "const": true },
            "capabilities": {
              "type": "array",
              "contains": { "const": "exact_evidence" },
              "items": {
                "enum": ["exact_evidence", "context_discovery"]
              },
              "uniqueItems": true
            },
            "freshness_max_age_hours": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "minimum_items": {
              "type": "integer",
              "minimum": 1
            },
            "max_response_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "request_timeout_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "refresh_interval_minutes": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "confirmation_identities": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/sourceIdentity" }
            },
            "context_identities": {
              "type": "array",
              "items": { "$ref": "#/$defs/sourceIdentity" }
            }
          }
        }
      }
    },
    "impact_tracking": {
      "$ref": "#/$defs/impactTrackingPolicy"
    },
    "model": {
      "type": "object",
      "properties": {
        "authority_timing": {
          "$ref": "#/$defs/authorityTimingPolicy"
        },
        "post_outcome_refractory": {
          "$ref": "#/$defs/postOutcomeRefractoryPolicy"
        },
        "evidence_carryover": {
          "$ref": "#/$defs/evidenceCarryoverPolicy"
        },
        "feature_support": {
          "$ref": "#/$defs/featureSupportPolicy"
        },
        "live_forecast_promotion_guard": {
          "$ref": "#/$defs/liveForecastPromotionGuardPolicy"
        }
      }
    }
  },
  "$defs": {
    "extractorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "model_version",
        "prompt_version",
        "topic_relevance_policy_version",
        "authority_reply_identity_ids",
        "semantic_assistance"
      ],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "topic_relevance_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "authority_reply_identity_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "semantic_assistance": {
          "$ref": "#/$defs/semanticAssistancePolicy"
        }
      }
    },
    "semanticAssistancePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "enabled",
        "protocol",
        "base_url",
        "model",
        "token_file",
        "prompt_version",
        "request_timeout_ms",
        "maximum_input_chars",
        "maximum_output_bytes",
        "max_tokens",
        "minimum_confidence",
        "maximum_observation_age_hours"
      ],
      "properties": {
        "policy_version": { "const": "semantic-timing-assistance/1" },
        "enabled": { "type": "boolean" },
        "protocol": { "const": "openai-compatible-chat-completions/1" },
        "base_url": { "type": "string", "format": "uri" },
        "model": { "type": "string", "minLength": 1 },
        "token_file": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "prompt_version": { "const": "authority-quote-timing/1" },
        "request_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "maximum_input_chars": {
          "type": "integer",
          "minimum": 256,
          "maximum": 20000
        },
        "maximum_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 32,
          "maximum": 2048
        },
        "minimum_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_observation_age_hours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 168
        }
      }
    },
    "xSearchGatewayProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "freshness_max_age_hours",
        "refresh_interval_minutes",
        "base_url",
        "upstream_provider",
        "token_file",
        "request_timeout_ms",
        "limit",
        "state_prefix",
        "confirmation_identities",
        "context_identities",
        "queries"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "freshness_max_age_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "refresh_interval_minutes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1440
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "upstream_provider": {
          "type": "string",
          "minLength": 1
        },
        "token_file": {
          "type": ["string", "null"]
        },
        "request_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "state_prefix": {
          "type": "string",
          "minLength": 1
        },
        "confirmation_identities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceIdentity" }
        },
        "context_identities": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceIdentity" }
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/xSearchGatewayQuery" }
        }
      }
    },
    "xSearchGatewayQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "query"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "handles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "search_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "impactTrackingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "enabled",
        "cluster_gap_hours",
        "active_evidence_ttl_hours",
        "freshness_half_life_hours"
      ],
      "properties": {
        "version": { "const": "impact-episode-policy/1" },
        "enabled": { "type": "boolean" },
        "cluster_gap_hours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 336
        },
        "active_evidence_ttl_hours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 168
        },
        "freshness_half_life_hours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 336
        }
      }
    },
    "authorityTimingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "enabled",
        "reliability_basis",
        "within_window_mass_basis",
        "within_window_baseline_power",
        "phase_reliability",
        "eligible_source_roles",
        "maximum_asserted_duration_hours"
      ],
      "properties": {
        "version": {
          "const": "authority-timing-first-event-mixture/2"
        },
        "enabled": { "type": "boolean" },
        "reliability_basis": {
          "const": "versioned_prior_non_exhaustive_statement_history"
        },
        "within_window_mass_basis": {
          "const": "tempered_baseline_first_event_mass"
        },
        "within_window_baseline_power": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "phase_reliability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheduled", "expected", "started"],
          "properties": {
            "scheduled": { "type": "number", "minimum": 0, "maximum": 1 },
            "expected": { "type": "number", "minimum": 0, "maximum": 1 },
            "started": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "eligible_source_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["official", "product_lead", "product_team_member"]
          }
        },
        "maximum_asserted_duration_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "postOutcomeRefractoryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "enabled",
        "outcome_selection_basis",
        "time_basis",
        "prior_basis",
        "recovery_curve"
      ],
      "properties": {
        "version": {
          "const": "post-outcome-refractory-piecewise-hazard-multiplier/1"
        },
        "enabled": { "type": "boolean" },
        "outcome_selection_basis": {
          "const": "latest_eligible_confirmed_outcome_available_at_cutoff"
        },
        "time_basis": { "const": "occurred_time_range_end" },
        "prior_basis": {
          "const": "versioned_non_learned_minimum_inter_event_prior"
        },
        "recovery_curve": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["elapsed_hours", "multiplier"],
            "properties": {
              "elapsed_hours": { "type": "number", "minimum": 0 },
              "multiplier": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "evidenceCarryoverPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "consume_outcome_lineage",
        "pre_outcome_multiplier"
      ],
      "properties": {
        "version": { "const": "post-outcome-evidence-carryover/1" },
        "consume_outcome_lineage": { "type": "boolean" },
        "pre_outcome_multiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "featureSupportPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "enabled",
        "minimum_nonzero_positive_events",
        "minimum_nonzero_negative_hours",
        "maximum_absolute_pairwise_correlation",
        "nonzero_epsilon"
      ],
      "properties": {
        "version": { "const": "feature-support-gate/1" },
        "enabled": { "type": "boolean" },
        "minimum_nonzero_positive_events": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_nonzero_negative_hours": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_absolute_pairwise_correlation": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "nonzero_epsilon": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "liveForecastPromotionGuardPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "enabled",
        "comparison_hours",
        "probability_ratio",
        "probability_ratio_denominator_floor",
        "minimum_candidate_probability",
        "minimum_absolute_probability_increase",
        "minimum_combined_positive_clip_logit_contribution",
        "maximum_cumulative_probability_by_horizon",
        "block_on_out_of_distribution_probability_anomaly"
      ],
      "properties": {
        "version": { "const": "live-forecast-promotion-guard/2" },
        "enabled": { "type": "boolean" },
        "comparison_hours": { "type": "integer", "minimum": 1 },
        "probability_ratio": { "type": "number", "exclusiveMinimum": 1 },
        "probability_ratio_denominator_floor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "minimum_candidate_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_absolute_probability_increase": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_combined_positive_clip_logit_contribution": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximum_cumulative_probability_by_horizon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["4", "24", "72"],
          "properties": {
            "4": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "24": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "72": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          }
        },
        "block_on_out_of_distribution_probability_anomaly": {
          "type": "boolean"
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username", "identity_id", "source_role"],
      "properties": {
        "username": { "type": "string", "minLength": 1 },
        "identity_id": { "type": "string", "minLength": 1 },
        "source_role": {
          "enum": [
            "official",
            "product_lead",
            "product_team_member",
            "employee",
            "community",
            "unknown"
          ]
        }
      }
    },
    "outcomeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "event_semantics",
        "authority_identity_ids",
        "negative_label_policy"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "event_semantics": { "type": "string", "minLength": 1 },
        "authority_identity_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "scope_policy": {
          "const": "explicit-platform-or-authority-general-codex/1"
        },
        "negative_label_policy": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "required": ["vendor", "product", "population"],
      "properties": {
        "vendor": { "type": "string", "minLength": 1 },
        "product": { "type": "string", "minLength": 1 },
        "population": { "type": "string", "minLength": 1 },
        "plans": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "regions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "quota_bucket": { "type": ["string", "null"] }
      }
    },
    "xOutcomeExhaustivenessContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "attestation_file", "attestation_sha256"],
      "properties": {
        "version": { "const": "x-outcome-exhaustiveness/1" },
        "attestation_file": { "type": "string", "minLength": 1 },
        "attestation_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "xOutcomeExhaustivenessAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_version",
        "contract_version",
        "provider",
        "exhaustive_for",
        "independent",
        "attestor",
        "method",
        "issued_at",
        "expires_at",
        "target_scope",
        "confirmation_identity_ids",
        "interval"
      ],
      "properties": {
        "attestation_version": {
          "const": "x-outcome-exhaustiveness-attestation/1"
        },
        "contract_version": { "const": "x-outcome-exhaustiveness/1" },
        "provider": { "const": "x" },
        "exhaustive_for": { "const": "completed_platform_reset_outcomes" },
        "independent": { "const": true },
        "attestor": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "issued_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "expires_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "target_scope": { "$ref": "#/$defs/scope" },
        "confirmation_identity_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "interval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end", "boundary"],
          "properties": {
            "start": { "type": "string", "format": "date-time", "pattern": "Z$" },
            "end": { "type": "string", "format": "date-time", "pattern": "Z$" },
            "boundary": { "const": "[start,end)" }
          }
        }
      }
    },
    "historicalDailyLedgerAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "provider",
        "independent",
        "attestor",
        "method",
        "exhaustive_for",
        "target_scope",
        "confirmation_identity_ids",
        "day_close_lag_hours",
        "minimum_stability_hours"
      ],
      "properties": {
        "version": { "const": "historical-daily-authority-ledger/1" },
        "provider": { "const": "historical_monitor" },
        "independent": { "const": true },
        "attestor": { "type": "string", "format": "uri" },
        "method": { "const": "contiguous_daily_grid+x_oembed+snowflake" },
        "exhaustive_for": {
          "const": "qualifying_completed_platform_reset_outcomes"
        },
        "target_scope": { "$ref": "#/$defs/scope" },
        "confirmation_identity_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "day_close_lag_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "minimum_stability_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        }
      }
    }
  }
}
