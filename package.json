{
  "name": "codex-reset-forecaster",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Provider-neutral Codex reset timing intelligence and hourly hazard forecasts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test --test-reporter=spec",
    "test:coverage": "node --test --experimental-test-coverage",
    "demo:seed": "node src/cli.mjs demo-seed",
    "demo:start": "node src/server.mjs --demo",
    "bot:start": "node src/telegram-bot.mjs",
    "web-push:generate-keys": "node scripts/generate-vapid-keys.mjs",
    "pipeline": "node src/cli.mjs pipeline",
    "evaluate": "node src/cli.mjs evaluate",
    "start": "node src/server.mjs"
  },
  "dependencies": {
    "web-push": "3.6.7"
  }
}
