  "impact_tracking": {
    "version": "impact-episode-policy/1",
    "enabled": true,
    "cluster_gap_hours": 72,
    "active_evidence_ttl_hours": 24,
    "freshness_half_life_hours": 36
  },
  "model": {
    "family": "ridge_logistic_discrete_time_hazard",
    "outcome_coverage_providers": ["x"],
    "lambda": 2.0,
    "learning_rate": 0.08,
    "gradient_tolerance": 0.00001,
    "objective_tolerance": 1e-10,
    "hessian_step": 0.0001,
    "standardized_feature_clip": 3,
    "max_iterations": 2500,
    "coefficient_priors": {
      "asserted_time_overlap": 0.5,
      "official_incident_decay": 0.2
    },
    "feature_support": {
      "version": "feature-support-gate/1",
      "enabled": true,
      "minimum_nonzero_positive_events": 3,
      "minimum_nonzero_negative_hours": 24,
      "maximum_absolute_pairwise_correlation": 0.995,
      "nonzero_epsilon": 1e-12
    },
    "authority_timing": {
      "version": "authority-timing-first-event-mixture/2",
      "enabled": true,
      "reliability_basis": "versioned_prior_non_exhaustive_statement_history",
      "within_window_mass_basis": "tempered_baseline_first_event_mass",
      "within_window_baseline_power": 0.5,
      "phase_reliability": {
        "scheduled": 0.8,
        "expected": 0.55,
        "started": 0.9
      },
      "eligible_source_roles": [
        "official",
        "product_lead",
        "product_team_member"
      ],
      "maximum_asserted_duration_hours": 48
    },
    "post_outcome_refractory": {
      "version": "post-outcome-refractory-piecewise-hazard-multiplier/1",
      "enabled": false,
      "outcome_selection_basis": "latest_eligible_confirmed_outcome_available_at_cutoff",
      "time_basis": "occurred_time_range_end",
      "prior_basis": "versioned_non_learned_minimum_inter_event_prior",
      "recovery_curve": [
        { "elapsed_hours": 0, "multiplier": 0.001 },
        { "elapsed_hours": 1, "multiplier": 0.002 },
        { "elapsed_hours": 4, "multiplier": 0.01 },
        { "elapsed_hours": 8, "multiplier": 0.10 },
        { "elapsed_hours": 12, "multiplier": 1.00 }
      ]
    },
    "evidence_carryover": {
      "version": "post-outcome-evidence-carryover/1",
      "consume_outcome_lineage": true,
      "pre_outcome_multiplier": 0.5
    },
    "live_forecast_promotion_guard": {
      "version": "live-forecast-promotion-guard/2",
      "enabled": false,
      "comparison_hours": 4,
      "probability_ratio": 10,
      "probability_ratio_denominator_floor": 0.000001,
      "minimum_candidate_probability": 0.5,
      "minimum_absolute_probability_increase": 0.25,
      "minimum_combined_positive_clip_logit_contribution": 3,
      "maximum_cumulative_probability_by_horizon": {
        "4": 0.8,
        "24": 0.98,
        "72": 0.995
      },
      "block_on_out_of_distribution_probability_anomaly": true
    },
    "minimum_outcomes": 3,
    "minimum_live_evaluation_windows": 1008,
    "minimum_live_evaluation_events": 20,
    "maximum_training_days": 180,
    "calibrator": {
      "version": "identity-hourly-hazard/1",
      "method": "identity",
      "fit_source": "none"
    },
    "promotion": {
      "minimum_event_window_recall": 0.8,
